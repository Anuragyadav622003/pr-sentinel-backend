# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr_sentinel

# Server
PORT=3000
FRONTEND_URL=http://localhost:3001

# GitHub App (webhooks + installation tokens)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth App (user login — separate from GitHub App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
