# Database
# Local dev: localhost | Docker Compose: postgres (set automatically in docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr_sentinel

# Redis (OAuth state + install state storage)
# Render: link Key Value to the web service — REDIS_URL is injected automatically.
# REDIS_URL=redis://red-xxxxxxxx:6379
# Local dev / Docker Compose:
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
PORT=3000
# Must match the deployed frontend origin exactly (no trailing slash).
# Cross-origin cookies (SameSite=None) activate when this is an https non-localhost URL.
FRONTEND_URL=http://localhost:3001

# GitHub App (webhooks + installation tokens)
GITHUB_APP_ID=
# Local dev only — Render/production must use GITHUB_APP_PRIVATE_KEY (inline PEM).
GITHUB_PRIVATE_KEY_PATH=
# Paste full PEM from GitHub App settings → Private keys (required on Render).
# Use literal \n for newlines if your host doesn't support multiline secrets.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# URL to the GitHub App installation page, e.g. https://github.com/apps/<your-app-slug>/installations/new
GITHUB_APP_INSTALL_URL=
# GitHub App "Setup URL" (set in GitHub developer settings, NOT here):
#   {FRONTEND_URL}/github/setup
# GitHub redirects here after install/update with installation_id + state query params.

# GitHub OAuth App (user login — separate from GitHub App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
